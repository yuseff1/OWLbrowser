{
  "name": "owl-browser",
  "productName": "OWL",
  "version": "0.1.0",
  "description": "OWL — an agentic Chromium browser with AI companions that work in your tabs.",
  "main": "dist/main/main.js",
  "author": "Youssef <hello@varsen.tech>",
  "license": "MIT",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "test:agents": "node tests/agents/run.js",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win dir --publish never",
    "test:main": "node tests/main/run.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@ghostery/adblocker-electron": "^2.20.1",
    "electron-updater": "^6.8.11",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/sql.js": "^1.4.9",
    "bits-ui": "^2.20.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "tech.varsen.owl",
    "productName": "OWL",
    "copyright": "Copyright © 2026 Varsen",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "yuseff1",
        "repo": "OWLbrowser",
        "releaseType": "release"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": false,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "OWL-${version}-${arch}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OWL",
      "include": "build/installer.nsh",
      "artifactName": "OWL-Setup-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "Web",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      }
    ]
  }
}
