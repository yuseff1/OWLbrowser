{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "svelte"
    ],
    "baseUrl": ".",
    "paths": {
      "$lib": [
        "src/renderer/lib"
      ],
      "$lib/*": [
        "src/renderer/lib/*"
      ],
      "$shared/*": [
        "src/shared/*"
      ]
    }
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.svelte",
    "src/shared/**/*.ts"
  ]
}
